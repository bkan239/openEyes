{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenEyes API",
    "version": "0.1.0"
  },
  "paths": {
    "/clips/upload-url": {
      "post": {
        "tags": [
          "clips"
        ],
        "summary": "Create Upload Url",
        "description": "Issue a presigned S3 URL and pre-register the clip's provenance.",
        "operationId": "create_upload_url_clips_upload_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadUrlResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clips": {
      "post": {
        "tags": [
          "clips"
        ],
        "summary": "Register Clip",
        "description": "Finalise a clip after the bytes are uploaded: verify, then cluster.",
        "operationId": "register_clip_clips_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterClipRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Register Clip Clips Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clips/{clip_id}/media": {
      "get": {
        "tags": [
          "clips"
        ],
        "summary": "Get Clip Media",
        "description": "Redirect to a short-lived presigned URL for the stored media.",
        "operationId": "get_clip_media_clips__clip_id__media_get",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Clip Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "List Events",
        "operationId": "list_events_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "type": "array",
                  "title": "Response List Events Events Get"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Get Event",
        "operationId": "get_event_events__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/verify/{clip_id}": {
      "post": {
        "tags": [
          "verify"
        ],
        "summary": "Verify Clip",
        "operationId": "verify_clip_verify__clip_id__post",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Clip Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClipVerification"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Clip": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "eventId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventid"
          },
          "sourceId": {
            "type": "string",
            "title": "Sourceid"
          },
          "mediaKey": {
            "type": "string",
            "title": "Mediakey"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          },
          "capturedAt": {
            "type": "string",
            "title": "Capturedat"
          },
          "receivedAt": {
            "type": "string",
            "title": "Receivedat"
          },
          "gps": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "deviceId": {
            "type": "string",
            "title": "Deviceid"
          },
          "durationSec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationsec"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded",
              "processing",
              "matched",
              "rejected"
            ],
            "title": "Status",
            "default": "uploaded"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClipVerification"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "mediaKey",
          "hash",
          "capturedAt",
          "receivedAt",
          "deviceId"
        ],
        "title": "Clip"
      },
      "ClipVerification": {
        "properties": {
          "aiManipulationScore": {
            "type": "number",
            "title": "Aimanipulationscore"
          },
          "provenanceValid": {
            "type": "boolean",
            "title": "Provenancevalid"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "aiManipulationScore",
          "provenanceValid"
        ],
        "title": "ClipVerification"
      },
      "CreateUploadUrlRequest": {
        "properties": {
          "contentType": {
            "type": "string",
            "title": "Contenttype"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          },
          "deviceId": {
            "type": "string",
            "title": "Deviceid"
          },
          "capturedAt": {
            "type": "string",
            "title": "Capturedat"
          },
          "gps": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "contentType",
          "hash",
          "deviceId",
          "capturedAt"
        ],
        "title": "CreateUploadUrlRequest"
      },
      "CreateUploadUrlResponse": {
        "properties": {
          "clipId": {
            "type": "string",
            "title": "Clipid"
          },
          "uploadUrl": {
            "type": "string",
            "title": "Uploadurl"
          },
          "mediaKey": {
            "type": "string",
            "title": "Mediakey"
          }
        },
        "type": "object",
        "required": [
          "clipId",
          "uploadUrl",
          "mediaKey"
        ],
        "title": "CreateUploadUrlResponse"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "disputed"
            ],
            "title": "Status"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "title": "Occurredat"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "trust": {
            "$ref": "#/components/schemas/TrustScore"
          },
          "clips": {
            "items": {
              "$ref": "#/components/schemas/Clip"
            },
            "type": "array",
            "title": "Clips"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "occurredAt",
          "createdAt",
          "trust",
          "clips"
        ],
        "title": "Event"
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoPoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RegisterClipRequest": {
        "properties": {
          "clipId": {
            "type": "string",
            "title": "Clipid"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          },
          "durationSec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationsec"
          }
        },
        "type": "object",
        "required": [
          "clipId"
        ],
        "title": "RegisterClipRequest"
      },
      "TrustScore": {
        "properties": {
          "score": {
            "type": "number",
            "title": "Score"
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/TrustSignal"
            },
            "type": "array",
            "title": "Signals"
          }
        },
        "type": "object",
        "required": [
          "score",
          "level",
          "signals"
        ],
        "title": "TrustScore"
      },
      "TrustSignal": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "value",
          "weight",
          "detail"
        ],
        "title": "TrustSignal"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
