# ─────────────────────────────────────────────────────────────────────────
# OpenEyes — local development environment
# Copy to `.env` and fill in. NEVER commit real secrets.
# In AWS (Lambda) these values are injected by SST — see sst.config.ts.
# ─────────────────────────────────────────────────────────────────────────

# --- Frontend (apps/web) ---
# When running `sst dev`, SST injects this automatically. For standalone
# `pnpm web:dev` against a local FastAPI, point it at the local server:
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (services/api), local `uv run uvicorn ...` only ---
# In AWS these come from SST (secret + linked resources), not from here.
OPENAI_API_KEY=sk-...
MEDIA_BUCKET=openeyes-dev-media
DATA_TABLE=openeyes-dev-data
AWS_REGION=eu-central-1
CORS_ORIGINS=*
STAGE=local
