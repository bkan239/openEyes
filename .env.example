# ─────────────────────────────────────────────────────────────────────────
# OpenEyes — backend local development environment
# Copy to `.env` and fill in. NEVER commit real secrets.
# In AWS (Lambda) these values are injected by SST — see sst.config.ts.
#
# Frontends point at the API themselves: iOS via its config, and `angles` via
# VITE_API_URL in angles/.env (defaults to the SST `api` output / localhost).
# ─────────────────────────────────────────────────────────────────────────

# --- Backend (services/api), local `uv run uvicorn ...` only ---
# In AWS these come from SST (secret + linked resources), not from here.
OPENAI_API_KEY=sk-...
MEDIA_BUCKET=openeyes-dev-media
DATA_TABLE=openeyes-dev-data
AWS_REGION=eu-central-1
CORS_ORIGINS=*
STAGE=local
