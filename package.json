{
  "name": "openeyes",
  "version": "0.1.0",
  "private": true,
  "description": "OpenEyes — verify real-world events by corroboration across independent recordings.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "sst dev",
    "api:dev": "cd services/api && uv run uvicorn app.main:app --reload --port 8000",
    "angles:dev": "cd angles && npm run dev",
    "angles:build": "cd angles && npm run build",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "deploy": "sst deploy",
    "deploy:api": "./scripts/deploy-api.sh",
    "deploy:vercel": "vercel deploy",
    "deploy:vercel:prod": "vercel deploy --prod",
    "deploy:angles": "vercel deploy --project open-eyes-angles",
    "deploy:angles:prod": "vercel deploy --prod --project open-eyes-angles",
    "deploy:prod": "sst deploy --stage production",
    "remove": "sst remove",
    "secret:openai": "sst secret set OpenAiApiKey"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.29",
    "sst": "^3.13.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "jszip": "^3.10.1"
  }
}
