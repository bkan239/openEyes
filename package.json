{
  "name": "openeyes",
  "version": "0.1.0",
  "private": true,
  "description": "OpenEyes — verify real-world events by corroboration across independent recordings.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "sst dev",
    "web:dev": "pnpm --filter @openeyes/web dev",
    "api:dev": "cd services/api && uv run uvicorn app.main:app --reload --port 8000",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "deploy": "sst deploy",
    "deploy:prod": "sst deploy --stage production",
    "remove": "sst remove",
    "secret:openai": "sst secret set OpenAiApiKey"
  },
  "devDependencies": {
    "sst": "^3.13.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
